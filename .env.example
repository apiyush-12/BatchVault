# BatchVault environment template.
#
# NAMES AND PLACEHOLDERS ONLY — never commit a real value to this file
# (architecture §15; security.md §12).
#
# Copy to `.env.local` (git-ignored) and fill in from the Supabase project for
# THIS environment. Local, preview and production use separate Supabase
# projects, and therefore separate URLs and keys (architecture §15).

# ---------------------------------------------------------------------------
# Client-safe. Inlined into the browser bundle by Next.js.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# For the local Supabase CLI stack this is http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable client credential. Public by design: it carries
# no authority of its own and every request it makes is constrained by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This product's own origin (no trailing slash). Used to build the absolute
# emailRedirectTo/redirectTo URLs Supabase Auth requires, and as the base for
# the allowlisted post-auth redirect targets (security.md §13).
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Server-only. NEVER prefixed NEXT_PUBLIC_, never read from client code.
# ---------------------------------------------------------------------------

# Supabase service-role secret. Bypasses RLS entirely — exposure is total loss
# of every privacy guarantee in the product (security.md §12). Used only by the
# narrow server-only client in lib/supabase/service-role.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the Vercel Cron sweep route (app/api/cron/sweep-media) checks
# before doing anything else (architecture §18.9). A long, random value —
# generate with e.g. `openssl rand -hex 32`. Configured as a Vercel Cron
# header, never a query string (security.md §9.1's URL-logging concern
# applies equally to any bearer-style secret).
CRON_SECRET=
